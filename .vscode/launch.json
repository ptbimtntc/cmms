{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🐬 Start MySQL",
            "type": "node-terminal",
            "request": "launch",
            "command": "bash .devcontainer/start-mysql.sh"
        },
        {
            "name": "🚀 Serve Laravel (artisan serve)",
            "type": "node-terminal",
            "request": "launch",
            "command": "php artisan serve --host=0.0.0.0 --port=8000"
        },
        {
            "name": "⚡ Full Dev (MySQL + Serve + Queue + Vite)",
            "type": "node-terminal",
            "request": "launch",
            "command": "bash .devcontainer/start-mysql.sh && composer run dev"
        },
        {
            "name": "🚀 Launch All (DB + Build + Serve)",
            "type": "node-terminal",
            "request": "launch",
            "command": "bash .devcontainer/start-mysql.sh && npm run build && php artisan serve --host=0.0.0.0 --port=8000"
        },
        {
            "name": "🐞 Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003
        }
    ]
}
